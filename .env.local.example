# Firebase (required) — copy from Firebase Console → Project Settings → Your apps
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Analytics (optional)
VITE_MIXPANEL_TOKEN=your_mixpanel_token

# --- Cloud Functions environment variables ---
# Set these with: firebase functions:config:set key=value
# Or use .env files in the functions/ directory (Gen 2) or Firebase secret manager

# Brevo SMTP — Settings → SMTP & API → SMTP tab
BREVO_SMTP_USER=your_smtp_login@smtp-brevo.com
BREVO_SMTP_KEY=your_brevo_smtp_password

# Anthropic Claude API — https://console.anthropic.com/settings/keys
# Used by the AI functions (knowledge gap, exit-interview sentiment analysis,
# and the exit-interview question generator).
# Store it in Secret Manager for deploys:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=sk-ant-...

# Stripe (payments)
# Frontend publishable key — exposed to the browser. Use pk_live_… in
# production and pk_test_… everywhere else.
VITE_STRIPE_PUBLIC_KEY=pk_test_...
# Cloud Functions secret key. Store it in Secret Manager:
#   firebase functions:secrets:set STRIPE_SECRET_KEY
# Locally, put it in functions/.env. Never commit it.
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret for the deployed endpoint, from the Stripe
# dashboard → Developers → Webhooks. Required by stripeWebhook.
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe price IDs, one per plan and billing cycle. These are NOT secret, but
# they are mode-specific: a test-mode price does not exist in live mode. With
# live keys these are mandatory — checkout refuses to run without them.
STRIPE_PRICE_BASIC_MONTHLY=price_...
STRIPE_PRICE_BASIC_ANNUAL=price_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_GROWTH_MONTHLY=price_...
STRIPE_PRICE_GROWTH_ANNUAL=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_ANNUAL=price_...

# Set to "true" only after activating Stripe Tax on the account; otherwise
# every checkout creation fails.
STRIPE_AUTOMATIC_TAX=false

# Public URL of the deployed app (used in email links)
APP_URL=https://your-project.web.app

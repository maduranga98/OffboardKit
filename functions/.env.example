# Cloud Functions environment variables.
#
# Copy to functions/.env and fill in. That file is gitignored — and it is also
# what `firebase deploy --only functions` uploads, so anything missing from it
# is missing from production. Secrets live in Secret Manager instead (see
# below); everything here is non-secret configuration.
#
# If billing reports "Billing is not configured on the server", the function
# log names the exact setting that is unset:
#
#   firebase functions:log --only createCheckoutSession | grep BILLING_CONFIG

# ── Where the app is served ─────────────────────────────────────────────
# Used for checkout return links and email links. MANDATORY with live Stripe
# keys; without it checkout would send paying customers to localhost.
APP_URL=https://offboardkit.web.app

# Optional: extra origins Stripe may return customers to, comma-separated.
# Only needed when the app is served from a domain that is neither APP_URL,
# one of its subdomains, nor a Firebase Hosting domain of this project.
# APP_RETURN_ORIGINS=https://app.example.com

# ── Stripe price IDs ────────────────────────────────────────────────────
# Not secret, but mode-specific: a price created in test mode does not exist
# in live mode. With a live secret key all eight are MANDATORY — there is no
# fallback, because reaching for a test price would fail at the customer's
# checkout. In test mode these may be omitted and bundled test IDs are used.
#
# Copy the price ID (price_…), not the product ID (prod_…).
STRIPE_PRICE_BASIC_MONTHLY=price_...
STRIPE_PRICE_BASIC_ANNUAL=price_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_GROWTH_MONTHLY=price_...
STRIPE_PRICE_GROWTH_ANNUAL=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_ANNUAL=price_...

# Stripe Tax. Off unless Tax is activated on the Stripe account — turning it
# on blindly makes every checkout creation fail.
# STRIPE_AUTOMATIC_TAX=true

# ── Secrets — do NOT put these here ─────────────────────────────────────
# Set them in Secret Manager, where the functions bind them via runWith():
#
#   firebase functions:secrets:set STRIPE_SECRET_KEY      # sk_live_… / sk_test_…
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET  # whsec_…
#   firebase functions:secrets:set ANTHROPIC_API_KEY      # sk-ant-…
#
# Locally, a functions/.env may hold them for the emulator only.
